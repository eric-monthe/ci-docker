# Copy this file to .env and change the values: cp .env.example .env
# .env is git-ignored, never commit it.

# ---- Database ----
POSTGRES_DB=workshopsdb
POSTGRES_USER=workshops_user
POSTGRES_PASSWORD=change_me

# ---- Images (clear version tags) ----
BACKEND_IMAGE=workshop-organizer:1.0.0
FRONTEND_IMAGE=olympic-games-starter:1.0.0

# ---- Host ports ----
BACKEND_PORT=8080
FRONTEND_PORT=80

# ---- Backup (offen/docker-volume-backup) ----
# every day at 02:00
BACKUP_CRON_EXPRESSION=0 2 * * *
BACKUP_RETENTION_DAYS=7
